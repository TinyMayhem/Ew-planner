{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/buddies.mjs": {
      "maxDuration": 30
    },
    "api/builds.mjs": {
      "maxDuration": 30
    },
    "api/r4-duel-backup.mjs": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/r4-planner",
      "destination": "/api/r4-planner"
    },
    {
      "source": "/r4-stats",
      "destination": "/api/r4-stats?view=1"
    },
    {
      "source": "/r4-reports",
      "destination": "/api/r4-stats?view=reports"
    },
    {
      "source": "/r4-nicknames",
      "destination": "/api/r4-stats?view=nicknames"
    },
    {
      "source": "/r4-audit",
      "destination": "/api/r4-stats?view=audit"
    },
    {
      "source": "/gear-beta",
      "destination": "/api/gear-beta"
    },
    {
      "source": "/gear-beta.html",
      "destination": "/api/gear-beta"
    },
    {
      "source": "/b/:id",
      "destination": "/ew-planner.html?shared=:id"
    }
  ],
  "crons": [
    {
      "path": "/api/r4-duel-backup",
      "schedule": "17 10 * * *"
    }
  ]
}
