{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "functions": {
    "api/buddies.mjs": {
      "maxDuration": 30
    },
    "api/builds.mjs": {
      "maxDuration": 30
    },
    "api/thp-update.mjs": {
      "maxDuration": 30
    },
    "api/devi.mjs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/arcade",
      "destination": "/api/buddies?arcade=1"
    },
    {
      "source": "/r4-hive",
      "destination": "/api/r4-planner?view=hive"
    },
    {
      "source": "/r4-planner",
      "destination": "/api/r4-planner"
    },
    {
      "source": "/r4-stats",
      "destination": "/api/r4-stats?view=1"
    },
    {
      "source": "/r4-reports",
      "destination": "/api/r4-stats?view=reports"
    },
    {
      "source": "/r4-nicknames",
      "destination": "/api/r4-stats?view=nicknames"
    },
    {
      "source": "/r4-polls",
      "destination": "/api/r4-stats?view=polls"
    },
    {
      "source": "/api/r4-polls",
      "destination": "/api/r4-stats?view=polls_api"
    },
    {
      "source": "/r4-audit",
      "destination": "/api/r4-stats?view=audit"
    },
    {
      "source": "/gear-beta",
      "destination": "/api/gear-beta"
    },
    {
      "source": "/gear-beta.html",
      "destination": "/api/gear-beta"
    },
    {
      "source": "/b/:id",
      "destination": "/ew-planner.html?shared=:id"
    },
    {
      "source": "/r4-duel-backup",
      "destination": "/api/r4-stats?duel_backup=1"
    }
  ],
  "crons": [
    {
      "path": "/r4-duel-backup",
      "schedule": "17 10 * * *"
    },
    {
      "path": "/api/devi?action=cleanup",
      "schedule": "0 11 * * *"
    }
  ]
}
